{"type":"effect-span","name":"sql.execute","traceId":"25fbd12d9e06505b672b6815ab455468","spanId":"192faf09f52ccf38","parentSpanId":"ef1cea59347fd211","sampled":true,"kind":"client","startTimeUnixNano":"1778107573335991600","endTimeUnixNano":"1778107573336083900","durationMs":0.0923,"attributes":{"db.name":"state.sqlite","service.name":"t3-server","db.system.name":"sqlite","db.operation.name":"execute","db.query.text":"\n        SELECT\n          thread_id AS \"threadId\",\n          project_id AS \"projectId\",\n          title,\n          model_selection_json AS \"modelSelection\",\n          runtime_mode AS \"runtimeMode\",\n          interaction_mode AS \"interactionMode\",\n          branch,\n          worktree_path AS \"worktreePath\",\n          latest_turn_id AS \"latestTurnId\",\n          created_at AS \"createdAt\",\n          updated_at AS \"updatedAt\",\n          archived_at AS \"archivedAt\",\n          latest_user_message_at AS \"latestUserMessageAt\",\n          pending_approval_count AS \"pendingApprovalCount\",\n          pending_user_input_count AS \"pendingUserInputCount\",\n          has_actionable_proposed_plan AS \"hasActionableProposedPlan\",\n          fork_source_thread_id AS \"forkSourceThreadId\",\n          fork_source_thread_title AS \"forkSourceThreadTitle\",\n          fork_source_user_message_id AS \"forkSourceUserMessageId\",\n          fork_imported_until_at AS \"forkImportedUntilAt\",\n          forked_at AS \"forkedAt\",\n          deleted_at AS \"deletedAt\"\n        FROM projection_threads\n        WHERE thread_id = ?\n          AND deleted_at IS NULL\n        LIMIT 1\n      "},"events":[],"links":[],"exit":{"_tag":"Success"}}
{"type":"effect-span","name":"sql.execute","traceId":"25fbd12d9e06505b672b6815ab455468","spanId":"02e4bc5ba3bf4e43","parentSpanId":"ef1cea59347fd211","sampled":true,"kind":"client","startTimeUnixNano":"1778107573336184400","endTimeUnixNano":"1778107573336227400","durationMs":0.043,"attributes":{"db.name":"state.sqlite","service.name":"t3-server","db.system.name":"sqlite","db.operation.name":"execute","db.query.text":"\n        SELECT\n          turns.thread_id AS \"threadId\",\n          turns.turn_id AS \"turnId\",\n          turns.state,\n          turns.requested_at AS \"requestedAt\",\n          turns.started_at AS \"startedAt\",\n          turns.completed_at AS \"completedAt\",\n          turns.assistant_message_id AS \"assistantMessageId\",\n          turns.source_proposed_plan_thread_id AS \"sourceProposedPlanThreadId\",\n          turns.source_proposed_plan_id AS \"sourceProposedPlanId\"\n        FROM projection_threads threads\n        JOIN projection_turns turns\n          ON turns.thread_id = threads.thread_id\n          AND turns.turn_id = threads.latest_turn_id\n        WHERE threads.thread_id = ?\n          AND threads.deleted_at IS NULL\n        LIMIT 1\n      "},"events":[],"links":[],"exit":{"_tag":"Success"}}
{"type":"effect-span","name":"sql.execute","traceId":"25fbd12d9e06505b672b6815ab455468","spanId":"9abc8a42f4b32247","parentSpanId":"ef1cea59347fd211","sampled":true,"kind":"client","startTimeUnixNano":"1778107573336249500","endTimeUnixNano":"1778107573336272000","durationMs":0.0225,"attributes":{"db.name":"state.sqlite","service.name":"t3-server","db.system.name":"sqlite","db.operation.name":"execute","db.query.text":"\n        SELECT\n          thread_id AS \"threadId\",\n          status,\n          provider_name AS \"providerName\",\n          provider_instance_id AS \"providerInstanceId\",\n          runtime_mode AS \"runtimeMode\",\n          active_turn_id AS \"activeTurnId\",\n          last_error AS \"lastError\",\n          updated_at AS \"updatedAt\"\n        FROM projection_thread_sessions\n        WHERE thread_id = ?\n        LIMIT 1\n      "},"events":[],"links":[],"exit":{"_tag":"Success"}}
